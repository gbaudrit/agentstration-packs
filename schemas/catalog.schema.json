{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentstration.io/schemas/pack-catalog-v1.json",
  "title": "Agentstration Pack Catalog",
  "type": "object",
  "required": [
    "apiVersion",
    "kind",
    "metadata",
    "spec"
  ],
  "properties": {
    "apiVersion": {
      "const": "agentstration.io/catalog/v1"
    },
    "kind": {
      "const": "PackCatalog"
    },
    "metadata": {
      "type": "object",
      "required": [
        "name",
        "publisher"
      ]
    },
    "spec": {
      "type": "object",
      "required": [
        "packs"
      ],
      "properties": {
        "packs": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "audience",
              "bindings",
              "categories",
              "displayName",
              "name",
              "publisher",
              "purpose",
              "resourceCount",
              "source",
              "tags",
              "version"
            ],
            "properties": {
              "audience": {
                "enum": ["personal", "professional", "universal"]
              },
              "bindings": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": ["name", "required", "targetKind"],
                  "properties": {
                    "name": { "type": "string" },
                    "required": { "type": "boolean" },
                    "targetKind": {
                      "enum": ["modelProfile", "secret"]
                    }
                  },
                  "additionalProperties": false
                }
              },
              "categories": {
                "type": "array",
                "items": { "type": "string" }
              },
              "description": { "type": ["string", "null"] },
              "displayName": { "type": "string" },
              "name": { "type": "string" },
              "publisher": { "type": "string" },
              "purpose": {
                "enum": ["sample", "template", "standard"]
              },
              "resourceCount": { "type": "integer", "minimum": 1 },
              "source": { "type": "string" },
              "strategy": { "type": ["string", "null"] },
              "tags": {
                "type": "array",
                "items": { "type": "string" }
              },
              "version": { "type": "string" }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
